---
import { Image } from 'astro:assets';

import { siteData } from '../../data/site-data'
import { isCurrentSection } from '../../lib/format'
import logo from '../../assets/seguin-island-logo.jpg'

const current = (href: string) => (isCurrentSection(Astro.url.pathname, href) ? { 'aria-current': 'page' } : {})
---

<a class="skip-link button" href="#main-content">Skip to content</a>
<header class="site-head">
  <div class="wrapper">
    <div class="repel site-head__inner">
      <div class="site-head__brand">
        <a href="/">
          <Image
            src={logo}
            alt={`${siteData.title}, home`}
            height={40}
            loading="eager"
            fetchpriority="high"
            draggable="false"
          />
        </a>
      </div>
      <nav aria-label="primary" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
          <li>
            <a href={item.href} {...current(item.href)}>{item.label}</a>
          </li>
        ))}
          <li>
            <a href="/donate" {...current('/donate')}>Donate</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
