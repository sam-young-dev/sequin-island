---
import { Image } from 'astro:assets';
import logo from '../../assets/seguin-island-logo.jpg';
import { siteData } from '../../data/site-data'
---

<div class="closer">
  <div class="wrapper closer__inner repel">
    <div class="closer__cta flow">
      <h2>Get in touch</h2>
      <p>Questions about visiting, volunteering, or joining? We're a quick email or call away.</p>
      <p class="closer__actions">
        <a class="button" data-button-variant="on-dark" href={`mailto:${siteData.contactEmail}`}>
          Email us <span class="closer__cta-arrow" aria-hidden="true">→</span>
        </a>
        <a class="closer__phone" href={siteData.officePhoneHref}>Call {siteData.officePhone}</a>
      </p>
    </div>

    <div class="closer__brand flow">
      <div class="logo-container">
        <Image
          src={logo}
          alt={siteData.title}
          width={360}
          widths={[360, logo.width]}
          sizes="22.5rem"
          loading="lazy"
        />
      </div>
      <p class="closer__address">
        {siteData.mailingAddress.map((line, index) => (
          <>
            {line}
            {index < siteData.mailingAddress.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>
  </div>
</div>