---
import { Image } from 'astro:assets';
import logo from '../../assets/seguin-island-logo.jpg';
import { siteData } from '../../data/site-data'
import { isCurrentSection } from '../../lib/format'
---

<div class="closer">
  <div class="wrapper flow">
    <div class="logo-container">
      <Image
        src={logo}
        alt={siteData.title}
        width={360}
        widths={[360, logo.width]}
        sizes="22.5rem"
        loading="lazy"
      />
    </div>

    <div class="closer__contact">
      <p><a href={`mailto:${siteData.contactEmail}`}>{siteData.contactEmail}</a></p>
      <p>
        {siteData.mailingAddress.map((line, index) => (
          <>
            {line}
            {index < siteData.mailingAddress.length - 1 && <br />}
          </>
        ))}
      </p>
    </div>

    {siteData.navItems.length > 0 && (
      <nav aria-label="Footer" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
            <li>
              <a href={item.href} {...(isCurrentSection(Astro.url.pathname, item.href) ? {'aria-current': 'page'} : {})}>{item.label}</a>
            </li>
          ))}
          <li><a href="/donate" {...(isCurrentSection(Astro.url.pathname, '/donate') ? {'aria-current': 'page'} : {})}>Donate</a></li>
        </ul>
      </nav>
    )}
  </div>
</div>