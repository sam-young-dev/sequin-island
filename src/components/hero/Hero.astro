---
import { Image } from 'astro:assets';

const { image, alt = '', width, height, label = 'Learn more', href = '#content', showIcon = false, size } = Astro.props;
---

<div class="hero" data-hero-size={size}>
  <Image
    src={image}
    alt={alt}
    width={width}
    height={height}
    widths={[640, 960, 1280, image.width].filter((w) => w <= image.width)}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    draggable="false"
  />
  {showIcon && (
    <a href={href} class="hero__skip-link flow">
      <span class="hero__skip-link-icon"><span class="hero__skip-link-icon__inner"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg></span></span>
      <span class="hero__skip-link-label">{label}</span>
    </a>
  )}
  {!showIcon && <div class="hero__content"><slot /></div>}
</div>