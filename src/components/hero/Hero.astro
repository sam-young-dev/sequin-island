---
import { Image } from '@unpic/astro';
import ArrowDownIcon from '/src/assets/arrow-down.svg?raw';
import { siteData } from '../../data/site-data';

const { image, alt = "", width, height, label, href, showIcon = false} = Astro.props;
---

<div class="hero">
  <Image
    src={image}
    alt={alt}
    width={width || 2000}
    height={height || 1200}
    loading="eager"
    fetchpriority="high"
    draggable="false"
  />
  <div class="hero__content"><slot /></div>
  {showIcon && (
    <a href={href || siteData.heroIcon.href} class="hero__skip-link flow">
      <span class="hero__skip-link-icon"><div class="hero__skip-link-icon__inner" set:html={ArrowDownIcon}></div></span>
      <span class="hero__skip-link-label">{label || siteData.heroIcon.label}</span>
    </a>
  )}
</div>