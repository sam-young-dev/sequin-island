---
import { Image } from '@unpic/astro';
import ArrowDownIcon from '/src/assets/arrow-down.svg?raw';

const { image, width, height, label = 'Learn more', href = '#content', showIcon = false } = Astro.props;
---

<div class="hero">
  <Image
    src={image}
    alt="hero banner"
    width={width || 2000}
    height={height || 1200}
    loading="eager"
    fetchpriority="high"
    draggable="false"
  />
  {showIcon && (
    <a href={href} class="hero__skip-link flow">
      <span class="hero__skip-link-icon"><div class="hero__skip-link-icon__inner" set:html={ArrowDownIcon}></div></span>
      <span class="hero__skip-link-label">{label}</span>
    </a>
  )}
  {!showIcon && <div class="hero__content"><slot /></div>}
</div>