---
// Today's predicted tide for the approach to Seguin, drawn from NOAA's
// Hunniwell Point station at the mouth of the Kennebec. The band renders its
// season and island facts at build time; the curve loads in the browser, and
// can step forward up to a week for planning a trip. Without JS the band keeps
// its facts and a link to NOAA, and the empty chart stays out of the way.
import { seasonCopy, seasonState } from "../../lib/season";

interface Props {
  /** The newest Keeper's Blog post, shown as the caretakers' latest word. */
  latest?: { title: string; href: string; date: string; datetime: string };
}

const { latest } = Astro.props;
const state = seasonState();
const season = seasonCopy(state);
const NOAA_PAGE = "https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id=8417177";
---

<section class="tide" aria-labelledby="tide-heading" data-tide data-state="static">
  <div class="wrapper tide__inner">
    <div class="tide__readout">
      <h2 id="tide-heading" class="tide__heading" data-heading>{state.open ? "The tide today" : "The tide today, off season"}</h2>
      <p class="tide__when" data-when>Predicted by NOAA for the mouth of the Kennebec.</p>
      <p class="tide__height"><span data-height>–</span><span class="tide__unit"> ft</span></p>
      <p class="tide__trend" data-trend>
        <noscript>The tide chart loads from NOAA with JavaScript. <a href={NOAA_PAGE}>See the week’s Hunniwell Point tides on NOAA</a>.</noscript>
      </p>
      <p class="tide__caution">
        A reading alone doesn’t say the beach is clear — <a href="#tide-access">check the landing</a> before you go.
      </p>
      <p class="tide__saved" data-saved hidden></p>
      <p class="tide__plan" data-plan hidden={state.open}>
        Planning a summer trip? NOAA publishes these predictions a year ahead: <a href={NOAA_PAGE}>pick your date on NOAA</a>.
      </p>
      <p class="visually-hidden" role="status" data-announce></p>
    </div>

    <div class="tide__access" id="tide-access">
      <p>
        <strong>Landing:</strong> until the new pier is finished, the beach can be reached for about three quarters of the tide cycle — landing is easiest near low tide and hardest in the last stretch before high water, when the cove’s rocks are covered. Call the office to check today’s window before you set out.
      </p>
      <p class="tide__actions">
        <a class="tide__call" href="tel:+12074434808">Call the office <span>207-443-4808</span></a>
        <a href="#coming-ashore" class="tide__cta">Moorings and coming ashore</a>
      </p>
    </div>

    <div class="tide__status-col">
      <dl class="tide__status">
        <div>
          <dt>Season</dt>
          <dd><strong data-season>{season.season}</strong>. The season runs Memorial Day to Labor Day.</dd>
        </div>
        <div>
          <dt>Caretakers</dt>
          <dd data-caretakers>{season.caretakers}</dd>
        </div>
        <div>
          <dt>Tower</dt>
          <dd><span data-tower>{season.tower}</span></dd>
        </div>
      </dl>
      {latest && (
        <p class="tide__latest">Latest from the island: <a href={latest.href}>{latest.title}</a>, <time datetime={latest.datetime}>{latest.date}</time></p>
      )}
    </div>

    <figure class="tide__chart">
      <div class="tide__plot" data-plot>
        <svg class="tide__svg" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="tide__water" data-water d="" />
          <path class="tide__line" data-line d="" />
        </svg>
        <div class="tide__marks" data-marks aria-hidden="true"></div>
        <div class="tide__now" data-now aria-hidden="true" hidden>
          <span class="tide__now-label">Now</span>
          <svg class="tide__grip" viewBox="0 0 44 16" focusable="false">
            <g class="tide__grip-left"><path class="tide__grip-halo" d="M9 3L4 8L9 13" /><path class="tide__grip-arrow" d="M9 3L4 8L9 13" /></g>
            <g class="tide__grip-right"><path class="tide__grip-halo" d="M35 3L40 8L35 13" /><path class="tide__grip-arrow" d="M35 3L40 8L35 13" /></g>
            <circle class="tide__grip-dot" cx="22" cy="8" r="6" />
          </svg>
        </div>
        <div class="tide__cursor" data-cursor aria-hidden="true" hidden>
          <svg class="tide__grip" viewBox="0 0 44 16" focusable="false">
            <g class="tide__grip-left"><path class="tide__grip-halo" d="M9 3L4 8L9 13" /><path class="tide__grip-arrow" d="M9 3L4 8L9 13" /></g>
            <g class="tide__grip-right"><path class="tide__grip-halo" d="M35 3L40 8L35 13" /><path class="tide__grip-arrow" d="M35 3L40 8L35 13" /></g>
            <circle class="tide__grip-dot" cx="22" cy="8" r="6" />
          </svg>
        </div>
        <label class="visually-hidden" for="tide-scrub">Read the tide at another time</label>
        <input class="tide__scrub" id="tide-scrub" type="range" min="0" max="360" step="1" value="60" data-scrub disabled />
      </div>
      <figcaption class="tide__source">
        <span>Predicted heights above low water (mean lower low water) at Hunniwell Point, Fort Popham (<a href={NOAA_PAGE}>NOAA station 8417177</a>), 3.6 miles north of the island. Times are Maine time.</span>
        <span class="tide__controls" data-controls>
          <span class="tide__hint">Drag the marker along the curve, or use the arrow keys, to read any time. Escape jumps back to now.</span>
          <span class="tide__days" role="group" aria-label="Day">
            <button class="tide__button" type="button" data-day-step="-1" disabled>Previous day</button>
            <button class="tide__button" type="button" data-day-step="1">Next day</button>
          </span>
          <button class="tide__button" type="button" data-back hidden>Back to now</button>
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { seasonCopy, seasonState } from "../../lib/season";

  const STATION = "8417177";
  const API = "https://api.tidesandcurrents.noaa.gov/api/prod/datagetter";
  const HOUR = 3_600_000;
  const DAY = 24 * HOUR;
  const DAYS_AHEAD = 6; // a week, today included
  const PLAN_HOUR = 9; // a future day opens on its morning
  const STEP = 6 * 60_000; // NOAA's 6-minute prediction interval
  let BEFORE = 6 * HOUR;
  let SPAN = 36 * HOUR;
  const W = 1000;
  const H = 300;

  const root = document.querySelector<HTMLElement>("[data-tide]")!;
  const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const when = $("[data-when]");
  const height = $("[data-height]");
  const trend = $("[data-trend]");
  const water = $<SVGPathElement>("[data-water]");
  const line = $<SVGPathElement>("[data-line]");
  const marks = $("[data-marks]");
  const nowMark = $("[data-now]");
  const cursor = $("[data-cursor]");
  const scrub = $<HTMLInputElement>("[data-scrub]");
  const back = $<HTMLButtonElement>("[data-back]");
  const heading = $("[data-heading]");
  const announce = $("[data-announce]");
  const savedNote = $("[data-saved]");
  const SAVED_KEY = `tide:${STATION}`;
  const SLOW_MS = 4000;
  const dayButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-day-step]")];

  // Station times are Maine wall-clock times. Everything here works in "naive"
  // milliseconds: that wall-clock time read as if it were UTC.
  const maineParts = new Intl.DateTimeFormat("en-US", {
    timeZone: "America/New_York",
    hourCycle: "h23",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
  const maineNow = () => {
    const p = Object.fromEntries(maineParts.formatToParts(new Date()).map((x) => [x.type, x.value]));
    return Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour, +p.minute);
  };
  const parse = (t: string) => {
    const [d, hm] = t.split(" ");
    const [y, mo, da] = d.split("-").map(Number);
    const [h, mi] = hm.split(":").map(Number);
    return Date.UTC(y, mo - 1, da, h, mi);
  };
  const stamp = (ms: number) => {
    const d = new Date(ms);
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${d.getUTCFullYear()}${pad(d.getUTCMonth() + 1)}${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
  };
  const clock = (ms: number) =>
    new Date(ms).toLocaleTimeString("en-US", { timeZone: "UTC", hour: "numeric", minute: "2-digit" }).toLowerCase();
  const weekday = (ms: number) => new Date(ms).toLocaleDateString("en-US", { timeZone: "UTC", weekday: "long" });
  const sameDay = (a: number, b: number) => Math.floor(a / (24 * HOUR)) === Math.floor(b / (24 * HOUR));
  const feet = (v: number) => v.toFixed(1);

  interface Point { t: number; v: number }
  interface Extreme extends Point { type: "H" | "L" }

  let series: Point[] = [];
  let extremes: Extreme[] = [];
  let start = 0;
  let lo = 0;
  let hi = 10;
  let scrubbed = false;
  /** Days ahead of today on show: 0 is today, with the now-marker. */
  let day = 0;
  /** Only the newest load may write to the band; stepping days quickly races. */
  let loadId = 0;

  const x = (t: number) => ((t - start) / SPAN) * 100;
  const y = (v: number) => ((hi - v) / (hi - lo)) * 100;

  function heightAt(t: number) {
    const i = Math.min(Math.max(Math.floor((t - start) / STEP), 0), series.length - 2);
    const a = series[i];
    const b = series[i + 1];
    return a.v + ((b.v - a.v) * (t - a.t)) / (b.t - a.t);
  }

  function describe(t: number, isNow: boolean) {
    const v = heightAt(t);
    const rising = heightAt(t + STEP) > v;
    const next = extremes.find((e) => e.t > t);
    const today = sameDay(t, maineNow());
    when.textContent = isNow ? `Now, ${clock(t)}` : `${today ? "Today" : weekday(t)}, ${clock(t)}`;
    height.textContent = feet(v);
    trend.textContent = next
      ? `${rising ? "Rising" : "Falling"}. ${next.type === "H" ? "High" : "Low"} water ${feet(next.v)} ft at ${clock(next.t)}${sameDay(next.t, t) ? "" : ` ${weekday(next.t)}`}.`
      : rising ? "Rising." : "Falling.";
    scrub.setAttribute("aria-valuetext", `${when.textContent}: ${feet(v)} feet, ${rising ? "rising" : "falling"}`);
  }

  function place(el: HTMLElement, t: number) {
    el.style.setProperty("--x", `${x(t)}%`);
    el.style.setProperty("--y", `${y(heightAt(t))}%`);
  }

  // "Now" sits right of its rule unless a high/low label is there; then it
  // tries the left, and if both sides are taken the rule and grip speak alone.
  const nowLabel = $(".tide__now-label");
  const overlaps = (a: DOMRect, b: DOMRect) => a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
  function settleNowLabel() {
    if (nowMark.hidden) return;
    const taken = [...marks.querySelectorAll(".tide__extreme")].map((el) => el.getBoundingClientRect());
    const clash = () => taken.some((rect) => overlaps(nowLabel.getBoundingClientRect(), rect));
    delete nowMark.dataset.label;
    if (!clash()) return;
    nowMark.dataset.label = "start";
    if (clash()) nowMark.dataset.label = "none";
  }
  window.addEventListener("resize", settleNowLabel, { passive: true });

  function showNow() {
    const now = maineNow();
    place(nowMark, now);
    nowMark.hidden = false;
    settleNowLabel();
    if (!scrubbed) {
      scrub.value = String(Math.round((now - start) / STEP));
      describe(now, true);
    }
  }

  function dayName(offset: number) {
    if (offset === 0) return "today";
    if (offset === 1) return "tomorrow";
    return `on ${weekday(maineNow() + offset * DAY)}`;
  }

  function draw() {
    const pts = series.map((p) => `${((x(p.t) / 100) * W).toFixed(1)},${((y(p.v) / 100) * H).toFixed(1)}`);
    line.setAttribute("d", `M${pts.join("L")}`);
    water.setAttribute("d", `M0,${H}L${pts.join("L")}L${W},${H}Z`);

    const labels: string[] = [];
    const edge = (t: number) => (x(t) < 5 ? ' data-edge="start"' : x(t) > 95 ? ' data-edge="end"' : "");
    // Clock ticks every six hours; midnight carries the day name.
    for (let t = Math.ceil(start / (6 * HOUR)) * 6 * HOUR; t < start + SPAN; t += 6 * HOUR) {
      const hour = new Date(t).getUTCHours();
      const text = hour === 0 ? weekday(t) : hour === 12 ? "noon" : clock(t).replace(":00", "");
      labels.push(`<span class="tide__tick" data-midnight="${hour === 0}"${edge(t)} style="--x:${x(t)}%">${text}</span>`);
    }
    for (const e of extremes) {
      if (e.t < start || e.t > start + SPAN) continue;
      labels.push(
        `<span class="tide__extreme" data-type="${e.type}"${edge(e.t)} style="--x:${x(e.t)}%;--y:${y(e.v)}%"><b>${feet(e.v)} ft</b> ${clock(e.t)}</span>`,
      );
    }
    marks.innerHTML = labels.join("");
  }

  async function fetchPredictions(interval: string) {
    const params = new URLSearchParams({
      product: "predictions",
      application: "FriendsOfSeguinIsland",
      begin_date: stamp(start),
      range: String(SPAN / HOUR),
      datum: "MLLW",
      station: STATION,
      time_zone: "lst_ldt",
      units: "english",
      interval,
      format: "json",
    });
    const response = await fetch(`${API}?${params}`, { signal: AbortSignal.timeout(12_000) });
    if (!response.ok) throw new Error(`NOAA responded ${response.status}`);
    const json = await response.json();
    if (!Array.isArray(json.predictions)) throw new Error(json.error?.message ?? "No predictions");
    return json.predictions as { t: string; v: string; type?: "H" | "L" }[];
  }

  // Predictions are worked out from the tide's harmonics well in advance, so a
  // copy saved on this device still holds when NOAA can't be reached from the
  // marina. It keeps a day back and everything fetched ahead.
  interface Saved { savedAt: number; series: Point[]; extremes: Extreme[] }

  function readSaved(): Saved | null {
    try {
      const raw = localStorage.getItem(SAVED_KEY);
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  }

  function save(fresh: Point[], freshExtremes: Extreme[]) {
    const old = readSaved();
    const floor = maineNow() - DAY;
    const merge = <T extends Point>(a: T[], b: T[]) => {
      const byTime = new Map<number, T>();
      for (const p of [...a, ...b]) if (p.t >= floor) byTime.set(p.t, p);
      return [...byTime.values()].sort((p, q) => p.t - q.t);
    };
    try {
      localStorage.setItem(
        SAVED_KEY,
        JSON.stringify({ savedAt: Date.now(), series: merge(old?.series ?? [], fresh), extremes: merge(old?.extremes ?? [], freshExtremes) }),
      );
    } catch {
      // Storage full or blocked: the band still works, just without a saved copy.
    }
  }

  /** The saved prediction for the window on show, only if it covers all of it without gaps. */
  function savedWindow() {
    const saved = readSaved();
    if (!saved) return null;
    const end = start + SPAN;
    const covered = saved.series.filter((p) => p.t >= start && p.t <= end);
    if (covered.length < 2 || covered[0].t !== start || covered[covered.length - 1].t < end - STEP) return null;
    if (covered.some((p, i) => i > 0 && p.t - covered[i - 1].t !== STEP)) return null;
    return {
      savedAt: saved.savedAt,
      series: covered,
      extremes: saved.extremes.filter((e) => e.t >= start && e.t <= end + 12 * HOUR),
    };
  }

  function savedWhen(savedAt: number) {
    const d = new Date(savedAt);
    const time = d.toLocaleTimeString("en-US", { timeZone: "America/New_York", hour: "numeric", minute: "2-digit" }).toLowerCase();
    const today = d.toLocaleDateString("en-US", { timeZone: "America/New_York" }) === new Date().toLocaleDateString("en-US", { timeZone: "America/New_York" });
    return today ? `earlier today at ${time}` : `${d.toLocaleDateString("en-US", { timeZone: "America/New_York", weekday: "long" })} at ${time}`;
  }

  function render(fresh: Point[], freshExtremes: Extreme[]) {
    series = fresh;
    extremes = freshExtremes;
    const values = series.map((p) => p.v);
    // Narrow plots keep room under the troughs, so low-water labels sit clear of the line.
    const narrow = root.hasAttribute("data-narrow");
    lo = Math.min(...values) - (narrow ? 5 : 1.5);
    hi = Math.max(...values) + 2.5;
    scrub.max = String(series.length - 1);
    scrub.disabled = false;
    draw();
  }

  /** Where a freshly opened day is read from: now for today, the morning for a later day. */
  function openAt(midnight: number) {
    if (day === 0) {
      backToNow();
    } else {
      nowMark.hidden = true;
      readAt(midnight + PLAN_HOUR * HOUR);
    }
  }

  const reading = () => `${when.textContent}: ${feet(heightAt(start + Number(scrub.value) * STEP))} feet. ${trend.textContent}`;

  async function load() {
    const id = ++loadId;
    // The curve draws in on the first load only; stepping days just swaps it.
    if (series.length) root.dataset.drawn = "";
    savedNote.hidden = true;
    heading.textContent = day === 0 && !seasonState().open ? "The tide today, off season" : `The tide ${dayName(day)}`;
    dayButtons.forEach((button) => {
      const next = day + Number(button.dataset.dayStep);
      button.disabled = next < 0 || next > DAYS_AHEAD;
    });
    // Phones get a day of tide; wider screens a day and a half.
    const narrow = root.clientWidth < 640;
    SPAN = (narrow ? 24 : 36) * HOUR;
    BEFORE = (narrow ? 4 : 6) * HOUR;
    root.toggleAttribute("data-narrow", narrow);
    // Today starts on the hour, a few hours back, so the curve shows where the
    // water has been. A later day starts at its midnight.
    const midnight = Math.floor(maineNow() / DAY) * DAY + day * DAY;
    start = day === 0 ? Math.floor((maineNow() - BEFORE) / HOUR) * HOUR : midnight;

    // A saved copy shows at once, so a slow connection never blanks the figure;
    // NOAA's answer then confirms it.
    const saved = savedWindow();
    if (saved) {
      render(saved.series, saved.extremes);
      openAt(midnight);
      root.dataset.state = "ready";
      announce.textContent = reading();
    } else {
      root.dataset.state = "loading";
      when.textContent = "Loading the prediction…";
      trend.textContent = "";
    }
    const slow = window.setTimeout(() => {
      if (id === loadId && root.dataset.state === "loading") when.textContent = "Still waiting on NOAA…";
    }, SLOW_MS);

    try {
      const [six, hilo] = await Promise.all([fetchPredictions("6"), fetchPredictions("hilo")]);
      if (id !== loadId) return;
      const fresh = six.map((p) => ({ t: parse(p.t), v: Number(p.v) }));
      const freshExtremes = hilo.map((p) => ({ t: parse(p.t), v: Number(p.v), type: p.type! }));
      if (fresh.length < 2) throw new Error("Too few predictions");
      save(fresh, freshExtremes);
      const unchanged = saved && fresh.length === series.length && fresh.every((p, i) => p.t === series[i].t && p.v === series[i].v);
      if (unchanged) return;
      if (saved) {
        // Swap in NOAA's copy where the saved one stood, without replaying the draw or moving the reader.
        root.dataset.drawn = "";
        render(fresh, freshExtremes);
        if (scrubbed) readAt(start + Number(scrub.value) * STEP);
        else showNow();
      } else {
        render(fresh, freshExtremes);
        openAt(midnight);
      }
      root.dataset.state = "ready";
      announce.textContent = reading();
    } catch (error) {
      if (id !== loadId) return;
      console.error(error);
      if (saved) {
        savedNote.innerHTML = `${navigator.onLine ? "NOAA didn’t answer" : "You appear to be offline"}, so this is the prediction saved on this device ${savedWhen(saved.savedAt)}. Tide predictions are worked out well ahead, so it still holds. <button class="tide__retry" type="button">Check NOAA again</button>`;
        savedNote.hidden = false;
        savedNote.querySelector(".tide__retry")?.addEventListener("click", load, { once: true });
        return;
      }
      root.dataset.state = "error";
      when.textContent = "The tide prediction didn’t load";
      height.textContent = "–";
      trend.innerHTML = navigator.onLine
        ? `NOAA’s service didn’t answer. <button class="tide__retry" type="button">Try again</button> or <a href="https://tidesandcurrents.noaa.gov/noaatidepredictions.html?id=${STATION}">see Hunniwell Point tides on NOAA</a>.`
        : `You appear to be offline. <button class="tide__retry" type="button">Try again</button> once you’re connected.`;
      trend.querySelector(".tide__retry")?.addEventListener("click", load, { once: true });
    } finally {
      window.clearTimeout(slow);
    }
  }

  // Back in signal range: try NOAA again without waiting to be asked.
  window.addEventListener("online", () => {
    if (root.dataset.state === "error" || !savedNote.hidden) load();
  });

  function readAt(t: number) {
    scrubbed = true;
    root.toggleAttribute("data-scrubbed", true);
    scrub.value = String(Math.round((t - start) / STEP));
    place(cursor, t);
    cursor.hidden = false;
    back.hidden = false;
    describe(t, false);
  }

  scrub.addEventListener("input", () => {
    if (!series.length) return;
    readAt(start + Number(scrub.value) * STEP);
  });

  function backToNow() {
    if (day !== 0) {
      day = 0;
      load();
      return;
    }
    scrubbed = false;
    root.toggleAttribute("data-scrubbed", false);
    cursor.hidden = true;
    back.hidden = true;
    showNow();
  }
  back.addEventListener("click", () => {
    backToNow();
    scrub.focus();
  });
  dayButtons.forEach((button) =>
    button.addEventListener("click", () => {
      day = Math.min(Math.max(day + Number(button.dataset.dayStep), 0), DAYS_AHEAD);
      load();
    }),
  );
  scrub.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && scrubbed) backToNow();
  });

  // Keep the season line current for a page built long ago.
  const copy = seasonCopy(seasonState());
  $("[data-plan]").hidden = seasonState().open;
  $("[data-season]").textContent = copy.season;
  $("[data-caretakers]").textContent = copy.caretakers;
  $("[data-tower]").textContent = copy.tower;

  // Move the now-marker along, and reload when the window has run on too far.
  window.setInterval(() => {
    if (root.dataset.state !== "ready" || day !== 0) return;
    if (maineNow() - start > 12 * HOUR) load();
    else showNow();
  }, 60_000);

  load();
</script>
