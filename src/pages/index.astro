---
import { getCollection, getEntry, render } from "astro:content";

import lighthouseImage from "../assets/seguin-island-hero.jpg";
import Card from "../components/card/Card.astro";
import Hero from "../components/hero/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, isoDate } from "../lib/format";

const home = await getEntry("home", "index");
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime())
  .slice(0, 6);

if (!home) {
  throw new Error("Missing home content entry at src/content/home/index.md");
}

const { Content } = await render(home);
---

<BaseLayout title={home.data.title} description={home.data.description}>
	<Hero image={lighthouseImage} alt="Seguin Light's tower and brick keeper's house on the island summit under a summer sky">
    <h1>{home.data.heroHeading}</h1>
    <p class="hero__coords">{home.data.heroEyebrow}</p>
  </Hero>
	
  <div class="region wrapper prose flow">
    <p>{home.data.intro}</p>
    <Content />
  </div>

  <div class="region wrapper" data-bg="tinted">
    <div class="switcher">
      <div class="card flow">
        <h2>{home.data.primaryCtaLabel}</h2>
        <p>Support the island through annual membership and help sustain preservation, education, and visitor access.</p>
        <p><a class="button" href={home.data.primaryCtaHref}>{home.data.primaryCtaLabel} →</a></p>
      </div>

      <div class="card flow">
        <h2>{home.data.secondaryCtaLabel}</h2>
        <p>Visiting this historic, active lighthouse is a memorable experience for visitors of all ages.</p>
        <p><a class="button" data-button-variant="secondary" href={home.data.secondaryCtaHref}>{home.data.secondaryCtaLabel} →</a></p>
      </div>
    </div>
  </div>

  <div class="region wrapper flow">
    <h2>{home.data.blogHeading}</h2>
    {
      posts.length > 0 ? (
        <ul class="grid" role="list" style="--grid-item-min: 20rem">
          {posts.map((post) => (
            <li>
              <Card href={`/blog/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
                <small><time datetime={isoDate(post.data.publishDate)}>{formatDate(post.data.publishDate)}</time></small>
              </Card>
            </li>
          ))}
        </ul>
      ) : (
        <p>The caretakers haven't posted yet this season. In the meantime, <a href="/map">explore the island in 3D</a>.</p>
      )
    }
    {posts.length > 0 && <p><a href="/blog">Visit the full blog →</a></p>}
  </div>

</BaseLayout>
