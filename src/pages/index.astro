---
import { getCollection, getEntry, render } from "astro:content";

import lighthouseImage from "../assets/seguin-island-hero.jpg";
import Card from "../components/card/Card.astro";
import Hero from "../components/hero/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const home = await getEntry("home", "index");
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime())
  .slice(0, 6);

if (!home) {
  throw new Error("Missing home content entry at src/content/home/index.md");
}

const { Content } = await render(home);
---

<BaseLayout title={home.data.title} description={home.data.description}>
	<Hero
    image={lighthouseImage}
    alt="Seguin Island Light Station's keeper's house and tower, seen from the surrounding hillside"
    showIcon
    href="#story"
    label="Read the island's story"
  >
    <p>{home.data.heroEyebrow}</p>
    <h1>{home.data.heroHeading}</h1>
  </Hero>

  <div class="region wrapper prose">
    <p>{home.data.intro}</p>
    <Content />
  </div>

  <div id="story" class="region" data-bg="loud">
    <div class="wrapper switcher prose">
      <div class="flow">
        <h2>{home.data.evidenceHeading}</h2>
        <p>{home.data.evidenceBody}</p>
      </div>
      <blockquote class="flow">
        <p>&ldquo;{home.data.evidenceQuote}&rdquo;</p>
        <footer>{home.data.evidenceQuoteAttribution}</footer>
      </blockquote>
    </div>
  </div>

  <div class="region wrapper">
    <div class="switcher">
      <div class="card flow" data-card-variant="primary">
        <h2>{home.data.primaryCtaLabel}</h2>
        <p>{home.data.primaryCtaBody}</p>
        <p><a class="button" href={home.data.primaryCtaHref}>{home.data.primaryCtaLabel} →</a></p>
      </div>

      <div class="card flow">
        <h2>{home.data.secondaryCtaLabel}</h2>
        <p>{home.data.secondaryCtaBody}</p>
        <p><a href={home.data.secondaryCtaHref}>{home.data.secondaryCtaLabel} →</a></p>
      </div>
    </div>
  </div>

  <div class="region wrapper flow" data-bg="tinted">
    <h2>{home.data.blogHeading}</h2>
    {
      posts.length > 0 ? (
        <>
          <Card href={`/blog/${posts[0].id}/`} label={posts[0].data.title} variant="feature">
            <h3>{posts[0].data.title}</h3>
            <p>{posts[0].data.excerpt}</p>
            <small class="card__meta">{posts[0].data.publishDate.toLocaleDateString("en-US", { dateStyle: "long" })}</small>
          </Card>

          {posts.length > 1 && (
            <>
              <hr />
              <ul class="grid" role="list">
                {posts.slice(1).map((post) => (
                  <li>
                    <Card href={`/blog/${post.id}/`} label={post.data.title}>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.excerpt}</p>
                      <small>{post.data.publishDate.toLocaleDateString("en-US", { dateStyle: "long" })}</small>
                    </Card>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      ) : (
        <p>No blog posts have been published yet.</p>
      )
    }
    <p><a href="/blog">Visit the full blog →</a></p>
  </div>

</BaseLayout>
