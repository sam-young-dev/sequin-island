---
import { getEntry, render } from "astro:content";

import lighthouseImage from "../../assets/seguin-island-hero.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";

const about = await getEntry("pages", "about");
const keepers = await getEntry("keepers", "index");

if (!about || !keepers) {
  throw new Error("Missing src/content/pages/about.md or src/content/keepers/index.md");
}

const { intro, timeline, facilities } = about.data;

if (!intro || !timeline?.length || !facilities?.length) {
  throw new Error("src/content/pages/about.md is missing intro, timeline, or facilities");
}

const introParagraphs = intro.split(/\n{2,}/);

const { Content } = await render(about);
const { Content: BecomeAKeeper } = await render(keepers);

// The most recent seasons, newest first; the full roll lives on /about/keepers
const recent = [...keepers.data.volunteers].sort((left, right) => right.year - left.year).slice(0, 5);
---

<BaseLayout title={about.data.title} description={about.data.description}>
  <div class="region wrapper about-intro prose flow">
    <h1>{about.data.title}</h1>
    {introParagraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>

  <section class="region wrapper about-section" aria-labelledby="timeline-heading">
    <h2 id="timeline-heading">Timeline</h2>
    <dl class="timeline">
      {timeline.map((entry) => (
        <div class="timeline__row">
          <dt class="timeline__year">{entry.year}</dt>
          <dd class="timeline__event">{entry.event}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="region wrapper about-section" aria-labelledby="facilities-heading">
    <h2 id="facilities-heading">Facilities</h2>

    <figure class="facilities__photo">
      <Picture src={lighthouseImage} alt="Seguin Light's tower and brick keeper's house on the island summit" width={900} formats={["avif", "webp"]} fallbackFormat="webp" />
      <figcaption>The light tower and keeper's house, the subjects of the parapet and window repairs below.</figcaption>
    </figure>

    <div class="facilities__list">
      {facilities.map((item) => (
        <div class="facilities__item flow">
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
          {item.cost && (
            <p class="facilities__cost"><span class="facilities__cost-label">Cost </span>{item.cost}</p>
          )}
        </div>
      ))}
    </div>

    <div class="about-callout">
      <p class="about-callout__label">Help fund this work</p>
      <p>The parapet, the pier, and the keeper's house windows above are funded by memberships and gifts, not grants alone. <a class="about-callout__cta" href="/donate">Make a gift →</a></p>
    </div>
  </section>

  <div class="region wrapper about-section prose flow">
    <Content />
  </div>

  <section class="region wrapper keepers-part" aria-labelledby="keepers-heading">
    <h2 id="keepers-heading">The keepers</h2>
    <p class="keepers-part__lead">Every season has its keepers. These are the most recent, from an honor roll that goes back to the station’s first keeper.</p>
    <ol class="keepers-roll" role="list" aria-label="Recent volunteer keepers">
      {recent.map((entry) => (
        <li class="keepers-roll__row">
          <span class="keepers-roll__year">{entry.year}</span>
          <span class="keepers-roll__names">{entry.names}</span>
        </li>
      ))}
    </ol>
    <p class="keepers-part__more"><a href="/about/keepers">All the keepers, back to 1796 →</a></p>
  </section>

  <section id="become-a-keeper" class="region wrapper keepers-part" aria-labelledby="become-heading">
    <h2 id="become-heading">Become a keeper</h2>
    <div class="keepers-part__body prose flow">
      <BecomeAKeeper />
    </div>
  </section>
</BaseLayout>
