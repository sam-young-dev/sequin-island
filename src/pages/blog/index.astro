---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime(),
);
---

<BaseLayout title="Keeper's Blog" description="Stories and updates from Seguin Island Light Station.">
  <div class="region wrapper prose flow">
    <h1>Keeper's Blog</h1>
    <p>Stories, seasonal updates, and preservation news from Seguin Island Light Station.</p>

    {
      posts.length > 0 ? (
        <ul class="post-list" role="list">
          {posts.map((post) => (
            <li class="flow">
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.excerpt}</p>
              <p class="byline">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString("en-US", { dateStyle: "long" })}
                </time>
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p>No posts have been published yet. Use Decap CMS to add the first entry.</p>
      )
    }
  </div>
</BaseLayout>