---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, isoDate } from "../../lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime(),
);
---

<BaseLayout title="Keeper's Blog" description="Stories and updates from Seguin Island Light Station.">
  <div class="region wrapper prose flow">
    <h1>Keeper's Blog</h1>
    <p>Stories, seasonal updates, and preservation news from Seguin Island Light Station.</p>

    {
      posts.length > 0 ? (
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <p>{post.data.excerpt}</p>
              <small><time datetime={isoDate(post.data.publishDate)}>{formatDate(post.data.publishDate)}</time></small>
            </li>
          ))}
        </ul>
      ) : (
        <p>The caretakers haven't posted yet this season. Check back soon, or <a href="/about">read the island's history</a> in the meantime.</p>
      )
    }
  </div>
</BaseLayout>