---
import { getEntry, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

const donate = await getEntry("pages", "donate");

if (!donate) {
  throw new Error("Missing src/content/pages/donate.md");
}

const { intro, lede, ctaLabel, ctaHref, reassurance, donorRightsHref } = donate.data;

if (!intro || !lede || !ctaLabel || !ctaHref || !reassurance || !donorRightsHref) {
  throw new Error(
    "src/content/pages/donate.md is missing one of intro, lede, ctaLabel, ctaHref, reassurance, or donorRightsHref",
  );
}

const { Content } = await render(donate);
---

<BaseLayout title={donate.data.title} description={donate.data.description}>
  <div class="region wrapper donate-intro">
    <h1>{donate.data.title}</h1>
    <p class="donate-intro__lead">{intro}</p>
  </div>

  <div class="region donate-ask" data-bg="tinted">
    <div class="wrapper donate-ask__inner">
      <div class="donate-ask__main flow">
        <p class="donate-ask__lede">{lede}</p>
        <p class="donate-ask__actions">
          <a class="button" data-button-variant="support" href={ctaHref} target="_blank" rel="noreferrer">
            {ctaLabel}
            <svg class="donate-ask__external" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M6 3.5h6.5V10M12.2 3.8 3.5 12.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </p>
        <p class="donate-ask__reassurance">
          {reassurance} Read our <a href={donorRightsHref} target="_blank" rel="noreferrer">Donor Bill of Rights</a>.
        </p>
      </div>
    </div>
  </div>

  <div class="region wrapper donate-more prose flow">
    <Content />
  </div>
</BaseLayout>
