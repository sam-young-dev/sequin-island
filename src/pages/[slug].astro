---
import { getCollection, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // About and Donate have their own routes (src/pages/about/, src/pages/donate.astro)
  // so they can carry the keepers section and the support-button ask, respectively
  const pages = await getCollection("pages", ({ id }) => id !== "about" && id !== "donate");

  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="region wrapper prose flow">
    <h1>{page.data.title}</h1>
    <Content />
  </div>
</BaseLayout>