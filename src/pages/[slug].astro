---
import { getCollection, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // About has its own route (src/pages/about/) so it can carry the keepers section
  const pages = await getCollection("pages", ({ id }) => id !== "about");

  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="region wrapper prose flow">
    <h1>{page.data.title}</h1>
    <Content />
  </div>
</BaseLayout>