{
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": "{font.serif}"
    },
    "heading": {
      "$value": "{font.sans}"
    },
    "sans": {
      "$value": [
        "Public Sans Variable",
        "Public Sans",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Consolas",
        "Liberation Mono",
        "Menlo",
        "monospace"
      ]
    },
    "serif": {
      "$value": [
        "Source Serif 4 Variable",
        "Source Serif 4",
        "Georgia",
        "Cambria",
        "Times New Roman",
        "Times",
        "serif"
      ]
    },
    "weight": {
      "$type": "fontWeight",
      "normal": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "text": {
    "xs": {
      "$value": "{size.step.-2}"
    },
    "sm": {
      "$value": "{size.step.-1}"
    },
    "base": {
      "$value": "{size.step.0}"
    },
    "lg": {
      "$value": "{size.step.1}"
    },
    "xl": {
      "$value": "{size.step.2}"
    },
    "2xl": {
      "$value": "{size.step.3}"
    },
    "3xl": {
      "$value": "{size.step.4}"
    },
    "4xl": {
      "$value": "{size.step.5}"
    },
    "5xl": {
      "$value": "{size.step.6}"
    },
    "6xl": {
      "$value": "{size.step.7}"
    },
    "7xl": {
      "$value": "{size.step.8}"
    },
    "8xl": {
      "$value": "{size.step.9}"
    },
    "9xl": {
      "$value": "{size.step.10}"
    }
  },
  "heading": {
    "1": {
      "$value": "{text.4xl}"
    },
    "2": {
      "$value": "{text.3xl}"
    },
    "3": {
      "$value": "{text.2xl}"
    },
    "4": {
      "$value": "{text.xl}"
    }
  },
  "body": {
    "default": {
      "$value": "{text.base}"
    },
    "large": {
      "$value": "{text.lg}"
    },
    "small": {
      "$value": "{text.sm}"
    }
  },
  "caption": {
    "$value": "{text.xs}"
  },
  "leading": {
    "$type": "number",
    "heading": {
      "$value": "{leading.snug}"
    },
    "body": {
      "$value": "{leading.normal}"
    },
    "title": {
      "$value": "{leading.tight}"
    },
    "prose": {
      "$value": "{leading.loose}"
    },
    "none": {
      "$value": 1
    },
    "snug": {
      "$value": 1.15
    },
    "tight": {
      "$value": 1.25
    },
    "normal": {
      "$value": 1.5
    },
    "relaxed": {
      "$value": 1.75
    },
    "loose": {
      "$value": 1.85
    }
  },
  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": {
        "value": -0.025,
        "unit": "rem"
      }
    },
    "normal": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "wide": {
      "$value": {
        "value": 0.025,
        "unit": "rem"
      }
    },
    "label": {
      "$value": {
        "value": 0.05,
        "unit": "rem"
      }
    }
  }
}
